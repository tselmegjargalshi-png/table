# ── Өгөгдлийн сан (PostgreSQL) ──
# Vercel + Neon/Supabase: DATABASE_URL нь pooled холболт, DIRECT_URL нь шууд холболт.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tablemn?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/tablemn?schema=public"

# ── Нэвтрэлт ── (хамгийн багадаа 32 тэмдэгт: `openssl rand -base64 48`)
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# ── Вэбсайтын хаяг ──
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Заавал биш: QR кодод restaurant.table.mn/{slug} хэлбэрийн хаяг ашиглах бол
# NEXT_PUBLIC_MENU_BASE_URL="https://restaurant.table.mn"

# ── Демо өгөгдөл шинэчлэх cron (Vercel Cron) ──
CRON_SECRET="replace-with-random-string"

# ── Заавал биш ──
# Нууц үг сэргээх имэйл (Resend). Тохируулаагүй үед холбоос серверийн логт гарна.
# RESEND_API_KEY=""
# MAIL_FROM="TABLE.MN <no-reply@your-domain.mn>"
# Имэйл холбоогүй орчинд нууц үг сэргээх холбоосыг дэлгэцэнд харуулах (зөвхөн демо)
# AUTH_SHOW_RESET_LINK="true"
# QPay (хэрэгжилт хийгдсэний дараа)
# QPAY_CLIENT_ID=""
# QPAY_CLIENT_SECRET=""
